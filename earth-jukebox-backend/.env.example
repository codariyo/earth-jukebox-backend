# GIBS anahtar istemez. Ileride anahtarli bir API eklersen buraya yaz.
# Bu dosyayi .env olarak kopyala; .env asla GitHub a gonderilmez.
NASA_API_KEY=

# Sunucu
HOST=127.0.0.1
PORT=3000

# Ag / onbellek (hepsi istege bagli)
HTTP_TIMEOUT=60              # tek bir NASA istegi icin zaman asimi (sn)
CAPABILITIES_TTL_HOURS=12    # GIBS katman/tarih listesi ne kadar onbellekte kalsin
MAX_PARALLEL_GIBS=4          # ayni anda en fazla kac NASA istegi
CACHE_DIR=cache              # exe'de varsayilan: %LOCALAPPDATA%\EarthJukebox\cache
